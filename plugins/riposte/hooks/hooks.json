{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/riposte-claims.mjs\" --hook --from-env --ledger \"${CLAUDE_PLUGIN_DATA}/receipts.jsonl\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/riposte-action-hook.mjs\" --hook --ledger \"${CLAUDE_PLUGIN_DATA}/receipts.jsonl\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
