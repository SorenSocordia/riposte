{
  "id": "financial-statement-core",
  "version": "0.2.0",
  "domain": "financial-statement",
  "name": "Financial statement articulation v0.2 — exception-aware, rounding-aware (implements workspace/receipts-spike/sec-check/ADDENDUM-V02.md; XBRL-US DQC-aligned identities, attribution: XBRL US Data Quality Committee, xbrl.us/data-quality)",
  "notes": [
    "Designed from the 2026q1 audit of v0.1, i.e. TUNED on 2026q1. Its only honest test is the held-out quarter (ADDENDUM-V02.md).",
    "Addendum item 1 (rounding): tolerance.rounding = infer, rel 0.0003, no cap: per check and filing, U = the largest of {1, 1000, 100000, 1000000} dividing every reported operand; tolerance = max(0.0003 x largest |operand|, U x number of operands).",
    "Addendum item 2 (exception-aware identities): optional terms ROLE? count as 0 when not reported; 'else' and 'paired consistently' are check alternatives, chosen by what is reported, never by outcome.",
    "Addendum item 3 (abstain guards): abstain_if_present / abstain_unless_all_present / abstain_if; the fixed tag lists are the field paths below.",
    "Field paths 'tags.<Tag>' read the raw us-gaap tag from the extraction (sec-run-v02.mts puts every tag this ruleset names under 'tags'). The v0.1 roles keep the v0.1 paths and so the frozen PREREG tag map. Only standard us-gaap elements are listed; filer-specific (custom) tags are deliberately not.",
    "Interpretations the addendum leaves open are listed in logs/agent-outputs/sec-v02-build-2026-09-24-1015.md (equity-method pairing, restricted-cash reading, tag lists)."
  ],
  "tolerance": { "rel": 0.0003, "absCap": 0, "rounding": "infer" },
  "fields": {
    "ASSETS":                 { "paths": ["assets", "total_assets", "Assets"] },
    "LIABILITIES":            { "paths": ["liabilities", "total_liabilities", "Liabilities"] },
    "EQUITY":                 { "paths": ["equity", "total_equity", "StockholdersEquity", "shareholders_equity"] },
    "LIAB_AND_EQUITY":        { "paths": ["liabilities_and_equity", "LiabilitiesAndStockholdersEquity"] },
    "CURRENT_ASSETS":         { "paths": ["current_assets", "AssetsCurrent"] },
    "NONCURRENT_ASSETS":      { "paths": ["noncurrent_assets", "AssetsNoncurrent"] },
    "CURRENT_LIABILITIES":    { "paths": ["current_liabilities", "LiabilitiesCurrent"] },
    "NONCURRENT_LIABILITIES": { "paths": ["noncurrent_liabilities", "LiabilitiesNoncurrent"] },
    "CASH_BS":                { "paths": ["cash", "cash_and_equivalents", "CashAndCashEquivalentsAtCarryingValue"] },

    "EQUITY_INCL_NCI":        { "paths": ["tags.StockholdersEquityIncludingPortionAttributableToNoncontrollingInterest"] },
    "NCI":                    { "paths": ["tags.MinorityInterest"] },
    "TEMP_EQUITY_TOTAL":      { "paths": ["tags.TemporaryEquityCarryingAmountIncludingPortionAttributableToNoncontrollingInterests"] },
    "TEMP_EQUITY_PARENT":     { "paths": ["tags.TemporaryEquityCarryingAmountAttributableToParent"] },
    "REDEEMABLE_NCI":         { "paths": ["tags.RedeemableNoncontrollingInterestEquityCarryingAmount", "tags.RedeemableNoncontrollingInterestEquityCommonCarryingAmount"] },

    "REVENUE":                { "paths": ["revenue", "revenues", "Revenues", "net_sales"] },
    "REVENUES_TAG":           { "paths": ["tags.Revenues"] },
    "REVENUE_CONTRACT_TAG":   { "paths": ["tags.RevenueFromContractWithCustomerExcludingAssessedTax"] },
    "COGS":                   { "paths": ["cost_of_goods_sold", "cogs", "CostOfGoodsAndServicesSold", "cost_of_revenue"] },
    "COGS_AMORTIZATION":      { "paths": ["tags.CostOfGoodsAndServicesSoldAmortization", "tags.CostOfGoodsAndServicesSoldDepreciationAndAmortization"] },
    "GROSS_PROFIT":           { "paths": ["gross_profit", "GrossProfit"] },
    "OPEX":                   { "paths": ["operating_expenses", "OperatingExpenses"] },
    "OTHER_OPERATING":        { "paths": ["tags.OtherOperatingIncomeExpenseNet", "tags.OtherOperatingIncome", "tags.OtherCostAndExpenseOperating"] },
    "OPERATING_INCOME":       { "paths": ["operating_income", "OperatingIncomeLoss"] },

    "PRETAX_INCL_EMI":        { "paths": ["tags.IncomeLossFromContinuingOperationsBeforeIncomeTaxesExtraordinaryItemsNoncontrollingInterest"] },
    "PRETAX_EXCL_EMI":        { "paths": ["tags.IncomeLossFromContinuingOperationsBeforeIncomeTaxesMinorityInterestAndIncomeLossFromEquityMethodInvestments"] },
    "EQUITY_METHOD_INCOME":   { "paths": ["tags.IncomeLossFromEquityMethodInvestments"] },
    "TAX":                    { "paths": ["income_tax_expense", "IncomeTaxExpenseBenefit", "tax"] },
    "PROFIT_LOSS":            { "paths": ["tags.ProfitLoss"] },
    "NET_INCOME_PARENT":      { "paths": ["tags.NetIncomeLoss"] },
    "DISCOPS_INCOME":         { "paths": ["tags.IncomeLossFromDiscontinuedOperationsNetOfTax", "tags.IncomeLossFromDiscontinuedOperationsNetOfTaxAttributableToReportingEntity"] },
    "DISCOPS_INCOME_PARENT":  { "paths": ["tags.IncomeLossFromDiscontinuedOperationsNetOfTaxAttributableToReportingEntity", "tags.IncomeLossFromDiscontinuedOperationsNetOfTax"] },

    "OCI":                    { "paths": ["other_comprehensive_income", "OtherComprehensiveIncomeLossNetOfTax"] },
    "OCI_PARENT":             { "paths": ["tags.OtherComprehensiveIncomeLossNetOfTaxPortionAttributableToParent", "tags.OtherComprehensiveIncomeLossNetOfTax"] },
    "CI_INCL_NCI":            { "paths": ["tags.ComprehensiveIncomeNetOfTaxIncludingPortionAttributableToNoncontrollingInterest"] },
    "CI_PARENT":              { "paths": ["tags.ComprehensiveIncomeNetOfTax"] },

    "CFO":                    { "paths": ["cash_from_operations", "NetCashProvidedByUsedInOperatingActivities"] },
    "CFI":                    { "paths": ["cash_from_investing", "NetCashProvidedByUsedInInvestingActivities"] },
    "CFF":                    { "paths": ["cash_from_financing", "NetCashProvidedByUsedInFinancingActivities"] },
    "FX_EFFECT":              { "paths": ["tags.EffectOfExchangeRateOnCashCashEquivalentsRestrictedCashAndRestrictedCashEquivalentsIncludingDisposalGroupAndDiscontinuedOperations", "tags.EffectOfExchangeRateOnCashCashEquivalentsRestrictedCashAndRestrictedCashEquivalents", "tags.EffectOfExchangeRateOnCashAndCashEquivalents", "tags.EffectOfExchangeRateOnCash"] },
    "NET_CASH_CHANGE":        { "paths": ["net_change_in_cash", "CashAndCashEquivalentsPeriodIncreaseDecrease"] },
    "BEGINNING_CASH":         { "paths": ["beginning_cash", "cash_beginning_of_period"] },
    "BEGINNING_CASH_LAG_DAYS": { "paths": ["beginning_cash_lag_days"], "kind": "quantity" },
    "ENDING_CASH":            { "paths": ["ending_cash", "cash_end_of_period"] },

    "RESTRICTED_CASH_TOTAL":      { "paths": ["tags.RestrictedCash", "tags.RestrictedCashAndCashEquivalents"] },
    "RESTRICTED_CASH_CURRENT":    { "paths": ["tags.RestrictedCashCurrent", "tags.RestrictedCashAndCashEquivalentsAtCarryingValue"] },
    "RESTRICTED_CASH_NONCURRENT": { "paths": ["tags.RestrictedCashNoncurrent", "tags.RestrictedCashAndCashEquivalentsNoncurrent"] }
  },
  "checks": [
    { "code": "BS_ACCOUNTING_EQUATION", "name": "DQC_0004 (v0.2): Assets = Liabilities + Equity incl. NCI + temporary equity", "field": "assets",
      "left": "ASSETS", "op": "=", "right": "LIABILITIES + EQUITY_INCL_NCI + TEMP_EQUITY_TOTAL",
      "alternatives": [
        { "left": "ASSETS", "right": "LIABILITIES + EQUITY_INCL_NCI + TEMP_EQUITY_PARENT? + REDEEMABLE_NCI?" },
        { "left": "ASSETS", "right": "LIABILITIES + EQUITY + NCI? + TEMP_EQUITY_TOTAL" },
        { "left": "ASSETS", "right": "LIABILITIES + EQUITY + NCI? + TEMP_EQUITY_PARENT? + REDEEMABLE_NCI?" }
      ] },
    { "code": "BS_LIAB_AND_EQUITY_TOTAL", "name": "DQC_0004: Assets = LiabilitiesAndStockholdersEquity", "field": "liabilities_and_equity", "left": "ASSETS", "op": "=", "right": "LIAB_AND_EQUITY" },
    { "code": "BS_ASSET_SPLIT", "name": "DQC_0004: Assets = AssetsCurrent + AssetsNoncurrent", "field": "assets", "left": "ASSETS", "op": "=", "right": "CURRENT_ASSETS + NONCURRENT_ASSETS" },
    { "code": "BS_LIABILITY_SPLIT", "name": "DQC_0004: Liabilities = LiabilitiesCurrent + LiabilitiesNoncurrent", "field": "liabilities", "left": "LIABILITIES", "op": "=", "right": "CURRENT_LIABILITIES + NONCURRENT_LIABILITIES" },

    { "code": "IS_GROSS_PROFIT", "name": "Income-statement footing: GrossProfit = Revenue − COGS (abstains on amortisation in cost of revenue, or when the two revenue tags disagree)", "field": "gross_profit",
      "left": "GROSS_PROFIT", "op": "=", "right": "REVENUE - COGS",
      "abstain_if_present": ["COGS_AMORTIZATION"],
      "abstain_if": [{ "left": "REVENUES_TAG", "op": "!=", "right": "REVENUE_CONTRACT_TAG" }] },
    { "code": "IS_OPERATING_INCOME", "name": "Income-statement footing: OperatingIncome = GrossProfit − OpEx (abstains when an 'other operating' line is reported)", "field": "operating_income",
      "left": "OPERATING_INCOME", "op": "=", "right": "GROSS_PROFIT - OPEX",
      "abstain_if_present": ["OTHER_OPERATING"] },
    { "code": "IS_NET_INCOME", "name": "Income-statement footing (v0.2): NetIncome = Pretax − Tax + EquityMethodIncome + DiscOps, paired consistently", "field": "net_income",
      "left": "PROFIT_LOSS", "op": "=", "right": "PRETAX_INCL_EMI - TAX + DISCOPS_INCOME?",
      "alternatives": [
        { "left": "PROFIT_LOSS", "right": "PRETAX_EXCL_EMI - TAX + EQUITY_METHOD_INCOME? + DISCOPS_INCOME?" },
        { "left": "NET_INCOME_PARENT", "right": "PRETAX_INCL_EMI - TAX + DISCOPS_INCOME_PARENT?" },
        { "left": "NET_INCOME_PARENT", "right": "PRETAX_EXCL_EMI - TAX + EQUITY_METHOD_INCOME? + DISCOPS_INCOME_PARENT?" }
      ] },
    { "code": "IS_COMPREHENSIVE_INCOME", "name": "DQC_0004 (v0.2): ComprehensiveIncome = NetIncome + OCI, paired consistently (incl. NCI with ProfitLoss, else parent with NetIncomeLoss)", "field": "comprehensive_income",
      "left": "CI_INCL_NCI", "op": "=", "right": "PROFIT_LOSS + OCI",
      "alternatives": [
        { "left": "CI_PARENT", "right": "NET_INCOME_PARENT + OCI_PARENT" }
      ] },

    { "code": "CF_NET_CHANGE", "name": "Cash-flow footing (v0.2): NetChange = CFO + CFI + CFF + FX (CFO/CFI/CFF include discontinued operations by definition)", "field": "net_change_in_cash",
      "left": "NET_CASH_CHANGE", "op": "=", "right": "CFO + CFI + CFF + FX_EFFECT?" },
    { "code": "CF_ENDING_CASH", "name": "DQC_0057: EndingCash = BeginningCash + NetChange (abstains unless the beginning balance is dated 350–380 days before the period end)", "field": "ending_cash",
      "left": "ENDING_CASH", "op": "=", "right": "BEGINNING_CASH + NET_CASH_CHANGE",
      "abstain_unless_all_present": ["BEGINNING_CASH_LAG_DAYS"],
      "abstain_if": [
        { "left": "BEGINNING_CASH_LAG_DAYS", "op": "<", "right": "350" },
        { "left": "BEGINNING_CASH_LAG_DAYS", "op": ">", "right": "380" }
      ] },

    { "code": "XSTMT_CASH_ARTICULATION", "name": "DQC_0057 (v0.2): cash-flow ending cash = balance-sheet cash + restricted cash (restricted-inclusive with restricted-inclusive; abstains when no restricted-cash component is reported)", "field": "cash",
      "left": "ENDING_CASH", "op": "=", "right": "CASH_BS + RESTRICTED_CASH_TOTAL",
      "alternatives": [
        { "left": "ENDING_CASH", "right": "CASH_BS + RESTRICTED_CASH_CURRENT + RESTRICTED_CASH_NONCURRENT?" },
        { "left": "ENDING_CASH", "right": "CASH_BS + RESTRICTED_CASH_NONCURRENT" }
      ] }
  ]
}
