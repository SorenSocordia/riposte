{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "riposte-verify": ["../verify/src/index.ts"],
      "riposte-ai": ["../receipts/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["bin", "node_modules", "test", "python"]
}
